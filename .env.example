# LeanAgent 配置。复制为 .env 并填入真实值。
# GLM 经 DashScope 的 OpenAI 兼容接口接入（不走 deepagents 的 "dashscope:glm" 字符串）。

DASHSCOPE_API_KEY=your_dashscope_key_here
GLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_MODEL=glm-5.2

# 可选：单独指定 grader 模型（默认与主模型相同）
# GRADER_MODEL=glm-5.2

# 可选：覆盖默认工作目录（宿主侧产出 PoC 的目录）
# LEANAGENT_WORKDIR=D:\Project\LeanAgent\workspace

# Reflexion 上限（RubricMiddleware 最大迭代次数）
LEANAGENT_MAX_ITERATIONS=15

# Docker pwn 镜像（现成镜像，不本地构建）
LEANAGENT_IMAGE=swr.cn-north-4.myhuaweicloud.com/securityllm/harvester:latest
