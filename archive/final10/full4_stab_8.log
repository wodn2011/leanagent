16f9: mov rdx, [rdx+rax]  ; rdx = msg[index] (re-read after write!)
16fd: mov eax, [rbp-0x14] ; eax = read_ret
1700: cdqe                ; sign-extend read_ret
1702: add rax, rdx        ; rax = msg[index] + read_ret
1705: movzx eax, [rax]    ; read byte at msg[index]+read_ret
