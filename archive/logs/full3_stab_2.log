    "attack_surfaces": [
      {
        "function": "eat_cookie",
        "input": "random_byte from /dev/urandom",
        "operation": "FREE msg[random_idx] then swap-remove without NULL-out",
        "risk": "HIGH",
        "reason": "After free, msg[old_cookie_num-1] still contains the freed pointer value (not NULLed). The swap copies msg[cookie_num-1] into msg[random_idx] but does not clear msg[cookie_num-1]. After cookie_num decrement, the old last slot index == new cookie_num, which is outside the valid range for edit/read checks (idx < cookie_num). However, if the freed pointer is swapped into a still-valid slot (when random_idx != cookie_num-1), the freed pointer becomes accessible via edit_cookie/read_cookie at that index."
      },
      {
        "function": "edit_cookie",
        "input": "user-controlled index (scanf %llu)",
        "operation": "READ msg[idx] heap pointer, WRITE to heap buffer with msg_size[idx]-1 bytes",
        "risk": "HIGH",
        "reason": "Attacker-controlled index reaches pointer dereference (msg[index]) and size lookup (msg_size[index]). If msg[index] points to freed/reused heap memory, this enables write to freed chunk. Index check is signed jl (index < cookie_num) — negative index not blocked by jl if value is large unsigned, but scanf %llu stores unsigned."
      },
      {
        "function": "read_cookie",
        "input": "user-controlled index (scanf %llu)",
        "operation": "READ msg[idx] heap pointer, PRINT via printf(%s, msg[idx])",
        "risk": "HIGH",
        "reason": "Attacker-controlled index reaches pointer dereference and printf output. If msg[index] points to freed/reused heap memory with attacker-controlled content, this enables information leak from heap."
      },
      {
        "function": "create_cookie",
        "input": "user-controlled size (scanf %lld)",
        "operation": "ALLOC calloc(size,1), WRITE read(0, buf, size)",
        "risk": "MEDIUM",
        "reason": "Size is checked <= 0x100 via signed jle. Since size is read via %lld (signed long long), negative values pass the <= 0x100 check. calloc with negative size (interpreted as very large unsigned) would fail returning NULL, but the code does not check calloc return value before read. If calloc returns NULL, read(0, NULL, size) would crash. No obvious overflow, but the allocated pointer and size are stored in msg/msg_size arrays at cookie_num index."
      },
      {
        "function": "edit_cookie",
        "input": "msg_size[index]-1 as read size",
        "operation": "READ size from msg_size[index], use as read length",
        "risk": "MEDIUM",
        "reason": "Read size is derived from msg_size array which is populated during create_cookie and shuffled during eat_cookie. If msg_size and msg arrays become desynchronized after eat_cookie swap-remove, the size used for read may not match the actual buffer at msg[index]."
      }
    ],
