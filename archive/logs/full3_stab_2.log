  "ctx_json": "{\"binary_info\":null,\"recon_report\":{\"schema\":\"ReconReport\",\"version\":\"1.0\",\"stage\":\"S1\",\"status\":\"COMPLETED\",\"binary\":{\"path\":\"/work/test/target\",\"arch\":\"x86-64\",\"bits\":64,\"endianness\":\"little\",\"entry\":\"0x1110\",\"dynamic\":true,\"stripped\":false,\"interpreter\":\"/lib64/ld-linux-x86-64.so.2\",\"compiler\":\"GCC 10.2.0 (Debian 10.2.0-16)\",\"source\":\"fortunecookie.c\"},\"security\":{\"relro\":{\"value\":\"full\",\"source\":\"ELF\"},\"nx\":{\"value\":true,\"source\":\"ELF\"},\"canary\":{\"value\":true,\"source\":\"ELF\"},\"pie\":{\"value\":true,\"source\":\"ELF\"},\"fortify\":{\"value\":false,\"source\":\"ELF\"},\"cet\":{\"ibt\":{\"value\":\"UNKNOWN\",\"source\":\"ELF\"},\"shstk\":{\"value\":\"UNKNOWN\",\"source\":\"ELF\"}},\"aslr\":{\"value\":true,\"source\":\"RUNTIME\"}},\"runtime\":{\"libc\":{\"version\":\"2.39\",\"path\":\"/lib/x86_64-linux-gnu/libc.so.6\",\"source\":\"RUNTIME\",\"build\":\"Ubuntu GLIBC 2.39-0ubuntu8.8\"},\"loader\":{\"path\":\"/lib64/ld-linux-x86-64.so.2\",\"source\":\"RUNTIME\"},\"libraries\":[\"libc.so.6\"]},\"interface\":{\"entry_function\":\"main\",\"input_sources\":[\"stdin\"],\"menu\":[\"==Fortune Cookie==\",\"1. Eat one cookie!!\",\"2. Make new cookie.\",\"3. Edit cookie msg.\",\"4. View cookie msg.\",\"5. exit\",\"==================\"],\"user_controlled_inputs\":[{\"name\":\"menu_choice\",\"source\":\"scanf(%lld)\",\"function\":\"main\",\"format\":\"%lld\"},{\"name\":\"message_size\",\"source\":\"scanf(%lld)\",\"function\":\"create_cookie\",\"format\":\"%lld\",\"constraint\":\"<= 0x100 (signed jle)\"},{\"name\":\"message_data\",\"source\":\"read(0, buf, size)\",\"function\":\"create_cookie\"},{\"name\":\"cookie_index\",\"source\":\"scanf(%llu)\",\"function\":\"edit_cookie\",\"format\":\"%llu\",\"constraint\":\"< cookie_num (signed jl)\"},{\"name\":\"new_message\",\"source\":\"read(0, msg[idx], msg_size[idx]-1)\",\"function\":\"edit_cookie\"},{\"name\":\"cookie_index\",\"source\":\"