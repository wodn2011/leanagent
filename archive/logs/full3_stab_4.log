    "attack_surfaces": [
      {
        "function": "eat_cookie",
        "input": "random_byte from /dev/urandom (not attacker-controlled, but determines which slot is freed)",
        "operation": "FREE msg[index] then swap-remove without nulling freed pointer",
        "risk": "HIGH",
        "reason": "After free(msg[index]), if index == cookie_num-1, the swap writes the same freed pointer back into msg[index], leaving a dangling pointer. Even if index != cookie_num-1, the freed chunk may be reallocated by subsequent create_cookie or strdup, and the old pointer in msg[cookie_num-1] (now moved to msg[index]) still points to valid memory — but the freed chunk itself can be reused. The freed pointer is never nulled, creating potential UAF if the freed chunk is reallocated and then accessed via edit/read."
      },
      {
        "function": "edit_cookie",
        "input": "index via scanf(%llu) and edit_data via read(0, msg[index], msg_size[index]-1)",
        "operation": "WRITE into msg[index] buffer with size = msg_size[index] - 1",
        "risk": "HIGH",
        "reason": "The read size is computed as msg_size[index] (int32) - 1, then sign-extended via movsxd. If msg_size[index] == 0, the result is -1 → 0xFFFFFFFF (sign-extended to 0xFFFFFFFFFFFFFFFF), causing read() to attempt writing a massive amount into the heap buffer. This is a potential heap overflow. Additionally, if msg[index] points to freed memory (UAF from eat_cookie), this write goes into a freed chunk."
      },
      {
        "function": "read_cookie",
        "input": "index via scanf(%llu)",
        "operation": "READ msg[index] and print via printf(%s)",
        "risk": "HIGH",
        "reason": "If msg[index] points to freed/reallocated heap memory (UAF from eat_cookie), printf(%s) will print whatever is in that memory, potentially leaking heap metadata or other data. This is a potential info leak."
      },
      {
        "function": "edit_cookie",
        "input": "index via scanf(%llu)",
        "operation": "index check uses signed jl but index is read as unsigned %llu",
        "risk": "MEDIUM",
        "reason": "The index is read via scanf(%llu) (unsigned) but the bounds check uses 'cmp rdx,rax; jl' (signed less-than). If cookie_num is small and index is a large unsigned value with bit 63 set, the signed comparison may pass, allowing OOB access to msg[] and msg_size[] arrays. However, this requires cookie_num to be positive and the index to have bit 63 set, which is an edge case."
      },
      {
        "function": "read_cookie",
        "input": "index via scanf(%llu)",
        "operation": "same signed/unsigned mismatch in bounds check",
        "risk": "MEDIUM",
        "reason": "Same signed jl comparison on unsigned %llu input as edit_cookie — potential OOB read of msg[] array."
      },
      {
        "function": "create_cookie",
        "input": "size via scanf(%lld)",
        "operation": "calloc(size, 1) then read(0, buf, size)",
        "risk": "LOW",
        "reason": "Size is checked <= 0x100 and calloc zeroes memory. The read size equals the allocation size, so no overflow here. The size is stored as int32 in msg_size[]."
