bals\",\"implication\":\"three distinct fixed write targets selectable by idx; target address NOT freely chosen -> RELATIVE_WRITE not ARB_WRITE\"}],\"verification_plan\":{\"method\":\"menu 3, idx=-8, send 16 bytes 'B'*16, observe 'Done!' and subsequent program behavior\",\"environment\":\"Ubuntu glibc 2.39, x86-64, local sandbox\",\"run_command\":\"timeout 20 python3 /work/test/poc-BUG-001.py\",\"expected_evidence\":[\"'New Message: Done!' printed (read executed)\",\"post-write abnormal behavior (hang/infinite loop) proving FILE struct corruption\"]},\"mitigations\":[{\"name\":\"Full RELRO\",\"present\":true,\"primitive_impact\":\"GOT not writable; but write target is libc FILE struct, unaffected by RELRO\"},{\"name\":\"PIE/ASLR\",\"present\":true,\"primitive_impact\":\"write destination comes from program's own global pointer, no address knowledge needed\"},{\"name\":\"NX\",\"present\":true,\"primitive_impact\":\"no effect on data write\"}],\"evidence\":[{\"id\":\"E003\",\"type\":\"STATIC\",\"function\":\"edit_cookie\",\"address\":\"0x1681-0x16de\",\"description\":\"jl signed check; lea rdx,[rax*4] / lea rcx,[rax*8] unsigned OOB indexing; movsxd sign-extends msg_size[idx]-1 to read size\"},{\"id\":\"E004\",\"type\":\"DYNAMIC\",\"function\":\"edit_cookie\",\"address\":\"0x16de\",\"description\":\"run_binary stdin '3\\\\n18446744073709551608\\\\nBBBB*16\\\\n5\\\\n': 'New Message: Done!' printed, then program entered infinite loop printing menu repeatedly (stdout_len=473839927 bytes before external timeout kill, rc=-124) — stdout FILE structure corrupted by attacker bytes, subsequent I/O loop broken\"}],\"verification_result\":{\"executed\":true,\"poc_path\":\"/work/test/poc-BUG-001.py\",\"written_value\":\"0x42424242424242424242424242424242 (16 bytes 'B')\",\"read_value\":\"\",\"fault_address\":\"\",\"return_code\":-124,\"details\":\"edit_cookie idx=-8 executed read(0, stdout_FILE*, -1); 'Done!' confirms write path executed; post-write infinite menu loop (473MB output, killed by timeout) proves memory at the OOB target was actually modified by attacker data. Target address is fixed (derived from msg[-8]=stdout FILE*), so classified RELATIVE_WRITE, not ARB_WRITE.\"},\"confidence\":\"HIGH\",\"notes\":\"Write content fully controlled; destination limited to fixed OOB-derived pointers (stdout/stdin/stderr FILE structs and other pre-msg globals). Not ARB_WRITE per acceptance standard (target address not freely chosen).\"},{\"primitive_id\":\"PRIM-003\",\"type\":\"RELATIVE_WRITE\",\"status\":\"VERIFIED\",\"kind\":\"DIRECT\",\"source\":{\"bug_id\":\"BUG-001\",\"root_cause\":\"same signedness mismatch, different OOB index\",\"description\":\"edit_cookie(idx=-6): read(0, msg[-6]=stdin FILE*, -1) writes attacker bytes into libc stdin FILE structure — second distinct OOB target proving index-controlled target selection among fixed globals\"},\"chain\":[\"BUG-001\",\"signedness mismatch\",\"msg[-6] OOB load of stdin FILE*\",\"read(0, stdin_FILE*, -1)\",\"RELATIVE_WRITE (second target)\"],\"controlled_element\":{\"what\":\"written content and OOB index selecting a different fixed global pointer target\",\"how\":\"menu 3 + idx=-6 + attacker bytes\",\"reach_sensitive_operation\":true},\"preconditions\":[{\"id\":\"PC-01\",\"description\":\"idx=-6 passes signed jl check\",\"necessity\":\"required\",\"verified\":true},{\"id\":\"PC-02\",\"description\":\"msg[-6] = stdin FILE* (0x4030) is writable\",\"necessity\":\"required\",\"verified\":true}],\"alias_key_findings\":[{\"expression\":\"msg[-6]\",\"alias\":\"stdin FILE* global at 0x4030\",\"implication\":\"distinct second write target, demonstrating target selection via idx across fixed global set\"}],\"verification_plan\":{\"method\":\"menu 3, idx=-6, 16 bytes 'C', observe 'Done!'\",\"environment\":\"Ubuntu glibc 2.39, x86-64, local sandbox\",\"run_command\":\"timeout 20 python3 /work/test/poc-BUG-001.py\",\"expected_evidence\":[\"'New Message: Done!' printed for idx=-6\"]},\"mitigations\":[{\"na