      "menu": [
        {
          "option": "1",
          "label": "Eat one cookie!!",
          "function": "eat_cookie",
          "desc": "随机选择一个cookie，打印其消息，free其内存，将最后一个cookie移到被删除的位置，cookie_num--"
        },
        {
          "option": "2",
          "label": "Make new cookie.",
          "function": "create_cookie",
          "desc": "用户指定消息长度(<=0x100)，calloc分配，read读取消息，存入msg[cookie_num]，msg_size[cookie_num]记录长度，cookie_num++"
        },
        {
          "option": "3",
          "label": "Edit cookie msg.",
          "function": "edit_cookie",
          "desc": "用户指定cookie索引，read读取msg_size[idx]-1字节到msg[idx]指向的buffer"
        },
        {
          "option": "4",
          "label": "View cookie msg.",
          "function": "read_cookie",
          "desc": "用户指定cookie索引，printf打印msg[idx]指向的字符串"
        },
        {
          "option": "5",
          "label": "exit",
          "function": "exit",
          "desc": "调用exit(0)"
        }
      ],
