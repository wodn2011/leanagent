    "vulnerabilities": [
      {
        "bug_id": "BUG-001",
        "title": "OOB_SIGNEDNESS_MISMATCH_INDEX_CHECK",
        "root_cause": {
          "type": "Signedness Error",
          "description": "edit_cookie and read_cookie read the user-supplied index via scanf(\"%llu\") (unsigned long long), but validate it against cookie_num using a signed 'jl' (jump if less) comparison with no lower-bound check. A large unsigned value such as 0xFFFFFFFFFFFFFFFF is interpreted as -1 in signed comparison, passing the check (-1 < cookie_num), and is then used directly as an array index with signed extension (cdqe/movsxd), producing a negative offset into the msg[] and msg_size[] arrays in BSS."
        },
        "affected_functions": [
          "edit_cookie",
          "read_cookie"
        ],
        "affected_objects": [
          "msg (0x4060, 32×8 char* array)",
          "msg_size (0x4160, 32×4 int array)",
          "stdout (0x4020, FILE*)",
          "stdin (0x4030, FILE*)",
          "stderr (0x4040, FILE*)"
        ],
        "attack_surface": {
          "input": "edit_index / view_index via scanf(\"%llu\")",
          "entry_function": "edit_cookie / read_cookie",
          "data_flow": [
            "Attacker provides large unsigned value (e.g. 0xFFFFFFFFFFFFFFFF) as index via scanf(\"%llu\") at edit_cookie:0x1671 / read_cookie:0x179a",
            "Value stored in stack variable [rbp-0x10] as unsigned long long",
            "Comparison: cmp rdx,rax; jl at 0x1684/0x17ad — signed comparison, no lower bound check, value -1 passes (-1 < 5)",
            "In edit_cookie: idx*4 used to read msg_size[idx] at 0x16b6 (OOB read of int), idx*8 used to read msg[idx] at 0x16d2 (OOB read of pointer)",
            "In edit_cookie: read_size = msg_size[idx]-1 (0x16b9), then read(0, *msg[idx], read_size) at 0x16de — writes attacker-influenced size to attacker-influenced pointer",
            "In read_cookie: idx*8 used to read msg[idx] at 0x17ce (OOB read of pointer), then printf(\"%s\", *msg[idx]) at 0x17e1 — dereferences and prints OOB pointer as string"
          ]
        },
        "security_check": {
          "expected": "Index should be validated as unsigned: 0 <= index < cookie_num, using both lower-bound (>= 0) and upper-bound (< cookie_num) checks with unsigned comparison (jb/jae).",
          "actual": "Only upper-bound check exists: cmp rdx,rax; jl (signed less-than). No lower-bound check. The %llu format reads an unsigned value but the jl instruction treats it as signed.",
          "missing_or_incorrect": "Missing lower-bound check (index >= 0) and incorrect comparison type (signed jl instead of unsigned jb). The signedness mismatch between %llu input format and jl comparison allows negative indices to bypass the bounds check."
        },
        "vulnerable_operation": {
          "operation": "OOB array read via negative index, followed by pointer dereference (read_cookie) or pointer dereference with write (edit_cookie)",
          "address": "edit_cookie: 0x16a7-0x16de (msg_size[idx] read, msg[idx] read, read() write); read_cookie: 0x17bf-0x17e1 (msg[idx] read, printf dereference)",
          "expression": "edit_cookie: msg_size[idx*4+0x4160] and msg[idx*8+0x4060] with negative idx; read_cookie: msg[idx*8+0x4060] with negative idx",
          "target": "BSS data before msg[] array: stdout(0x4020), stdin(0x4030), stderr(0x4040) FILE* pointers accessible at idx=-8, -6, -4 respectively via msg[] OOB",
          "size": "edit_cookie: write size = msg_size[idx]-1 (OOB-derived, attacker-influenced); read_cookie: reads until NUL terminator in printf(%s)"
        },
        "impact": [
          {
            "type": "OOB_READ",
            "status": "CANDIDATE",
            "reason": "Negative index causes out-of-bounds read from msg[] array in BSS. In read_cookie, the OOB-read pointer value (e.g., FILE* at stdout/stdin/stderr addresses) is dereferenced and printed via printf(%s), potentially leaking memory contents at the pointed-to address. In edit_cookie, both msg_size[idx] and msg[idx] are read OOB to determine write destination and size."
          },
          {
            "type": "OOB_WRITE",
            "status": "CANDIDATE",
            "reason": "In edit_cookie, the OOB-read pointer from msg[negative_idx] is used as the write destination for read(), and the OOB-read int from msg_size[negative_idx] determines the write size. If the OOB pointer value happens to be a valid writable address (e.g., a FILE* struct pointer in BSS pointing to a heap-allocated FILE), data from stdin is written to that address."
          },
          {
            "type": "INFO_LEAK",
            "status": "CANDIDATE",
            "reason": "In read_cookie, printf(\"%s\", msg[negative_idx]) dereferences an OOB-obtained pointer and prints the memory at that address as a string until a NUL byte. If the pointer value comes from stdout/stdin/stderr FILE* entries, it points to heap-allocated FILE structures, leaking heap memory contents."
          },
