      {
        "function": "edit_cookie",
        "input": "index (scanf %llu, unsigned 64-bit)",
        "operation": "signed comparison jl for index < cookie_num; no lower bound; index used to address msg[index] and msg_size[index]",
        "risk": "HIGH",
        "reason": "Attacker-controlled index read as unsigned %llu but compared with signed jl. A large unsigned value (high bit set, e.g. 0xffffffffffffffff = -1 signed) passes the signed < cookie_num check. This index is then used to compute msg+index*8 (pointer dereference for read destination) and msg_size+index*4 (read length). This reaches pointer dereference and heap write with attacker-controlled index."
      },
      {
        "function": "read_cookie",
        "input": "index (scanf %llu, unsigned 64-bit)",
        "operation": "signed comparison jl for index < cookie_num; no lower bound; index used to address msg[index] for printf %s",
        "risk": "HIGH",
        "reason": "Same signed comparison issue as edit_cookie. Attacker-controlled index reaches msg+index*8 pointer dereference, and the pointed-to value is used as a string pointer for printf. This is a potential arbitrary read via controlled pointer dereference."
      },
      {
        "function": "eat_cookie",
