      {
        "bug_id": "BUG-002",
        "title": "Use-After-Free via eat_cookie compaction (stale duplicate pointer not cleared)",
        "root_cause": {
          "type": "Use-After-Free",
          "description": "eat_cookie frees msg[random_idx] and compacts by moving msg[cookie_num-1] into msg[random_idx]. However, msg[cookie_num-1] is NOT cleared after the copy, leaving a duplicate pointer. If a subsequent eat_cookie call's random_idx equals the current cookie_num-1 (the stale slot), it frees the duplicate pointer. Any other in-range slot that received the same pointer during a prior compaction now holds a dangling pointer to freed memory."
        },
        "affected_functions": [
          "eat_cookie",
          "edit_cookie",
          "read_cookie"
        ],
        "affected_objects": [
          "msg (pointer array at 0x4060)",
          "msg_size (int array at 0x4160)",
          "cookie_num (at 0x41e8)"
        ],
        "attack_surface": {
          "input": "Repeated eat_cookie invocations (option 1) — index is from /dev/urandom (not directly attacker-controlled), but attacker controls timing and number of calls",
          "entry_function": "eat_cookie",
          "data_flow": [
            "eat_cookie call 1: random_idx=A (A != cookie_num-1). free(msg[A]). msg[A] = msg[cookie_num-1]. msg[cookie_num-1] NOT cleared (duplicate pointer). cookie_num--.",
            "Now msg[A] (in-range) and msg[old_cookie_num-1] (out-of-range) both point to same block P.",
            "eat_cookie call 2: random_idx = new_cookie_num-1 = old_cookie_num-1. free(msg[old_cookie_num-1]) = free(P). msg[old_cookie_num-1] = msg[new_cookie_num-1] (compaction). cookie_num--.",
            "Now msg[A] (still in-range if A < new_cookie_num) holds dangling pointer to freed block P.",
            "edit_cookie(msg[A]) or read_cookie(msg[A]) accesses freed memory → UAF."
          ]
        },
        "security_check": {
          "expected": "After moving msg[cookie_num-1] to msg[random_idx], msg[cookie_num-1] should be set to NULL to prevent duplicate/stale pointer",
          "actual": "msg[cookie_num-1] is not cleared after the copy, leaving a duplicate pointer that can be freed again by a subsequent eat_cookie call",
          "missing_or_incorrect": "Missing NULL assignment to msg[cookie_num-1] after compaction copy"
        },
