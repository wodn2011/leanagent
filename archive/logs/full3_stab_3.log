        "title": "OOB_SIGNEDNESS_MISMATCH_INDEX_VALIDATION",
        "root_cause": {
          "type": "Signedness Error",
          "description": "edit_cookie and read_cookie accept an attacker-controlled index via scanf(\"%lld\") as a signed int64. The only bounds check is 'cmp rdx, rax; jl' (signed jump-if-less) comparing the index against cookie_num. This check only verifies index < cookie_num (upper bound) but performs NO lower bound check. Because the comparison is signed (jl), negative index values pass the check. A negative index causes out-of-bounds access to memory before the msg[] array (base 0x4060) and msg_size[] array (base 0x4160) in .bss."
        },
        "affected_functions": [
          "edit_cookie",
          "read_cookie"
        ],
        "affected_objects": [
          "msg[] array at 0x4060 (32 × 8 bytes)",
          "msg_size[] array at 0x4160 (32 × 4 bytes)",
          "stderr FILE* at 0x4040",
          "stdin FILE* at 0x4030",
          "stdout FILE* at 0x4020"
        ],
        "attack_surface": {
          "input": "edit_index / view_index via scanf(\"%lld\") — signed int64, accepts negative values",
          "entry_function": "edit_cookie (0x1628) / read_cookie (0x1751)",
          "data_flow": [
            "Attacker provides negative index via scanf(\"%lld\") → stored as int64 in [rbp-0x10]",
            "Index loaded into rdx: 'mov rdx, [rbp-0x10]'",
            "Compared against cookie_num (rax): 'cmp rdx, rax; jl' — signed comparison, negative passes",
            "edit_cookie: index used to compute msg_size[index] at 0x4160 + index*4 (OOB read for size)",
            "edit_cookie: index used to compute msg[index] at 0x4060 + index*8 (OOB read for pointer)",
            "edit_cookie: read(0, msg[index], msg_size[index]-1) — writes to OOB-derived pointer with OOB-derived size",
            "read_cookie: printf(\"%s\", msg[index]) — dereferences OOB-derived pointer and prints as string"
          ]
        },
        "security_check": {
          "expected": "Index should be validated with both lower bound (>= 0) and upper bound (< cookie_num) checks, using unsigned comparison to reject negative values.",
          "actual": "Only upper bound check exists: 'cmp rdx, rax; jl' (signed jump-if-less). No lower bound check. Negative values pass because signed comparison treats them as less than cookie_num.",
          "missing_or_incorrect": "Missing lower bound check (index >= 0). Signed comparison (jl) instead of unsigned (jb) allows negative indices to bypass the upper bound check."
        },
