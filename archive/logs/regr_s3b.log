unction\":\"read_cookie\",\"type\":\"int64\"},{\"name\":\"message_data\",\"source\":\"read(0, buf, size)\",\"function\":\"create_cookie\",\"type\":\"bytes\"},{\"name\":\"edit_data\",\"source\":\"read(0, buf, msg_size[idx]-1)\",\"function\":\"edit_cookie\",\"type\":\"bytes\"}]},\"memory\":{\"sections\":[{\"name\":\".text\",\"address\":\"0x1110\",\"size\":\"0x891\",\"permissions\":\"R-X\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".rodata\",\"address\":\"0x2000\",\"size\":\"0x266\",\"permissions\":\"R--\",\"writable\":false,\"executable\":false,\"readable\":true},{\"name\":\".data\",\"address\":\"0x4000\",\"size\":\"0x10\",\"permissions\":\"RW-\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".bss\",\"address\":\"0x4020\",\"size\":\"0x1d0\",\"permissions\":\"RW-\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".got\",\"address\":\"0x3f58\",\"size\":\"0xa8\",\"permissions\":\"RW-\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".plt\",\"address\":\"0x1020\",\"size\":\"0xe0\",\"permissions\":\"R-X\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".init\",\"address\":\"0x1000\",\"size\":\"0x17\",\"permissions\":\"R-X\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".fini\",\"address\":\"0x19a4\",\"size\":\"0x9\",\"permissions\":\"R-X\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".init_array\",\"address\":\"0x3d58\",\"size\":\"0x8\",\"permissions\":\"RW-\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".fini_array\",\"address\":\"0x3d60\",\"size\":\"0x8\",\"permissions\":\"RW-\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".eh_frame\",\"address\":\"0x22e0\",\"size\":\"0x1e0\",\"permissions\":\"R--\",\"writable\":false,\"executable\":false,\"readable\":true},{\"name\":\".eh_frame_hdr\",\"address\":\"0x2268\",\"size\":\"0x74\",\"permissions\":\"R--\",\"writable\"