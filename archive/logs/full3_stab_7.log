          "missing_or_incorrect": "Missing lower-bound check (idx >= 0) AND incorrect comparison type: signed jl instead of unsigned jb. The scanf format %llu reads unsigned, but the comparison treats the value as signed, creating a signedness mismatch that allows negative-index OOB access."
        },
        "vulnerable_operation": {
          "operation": "OOB array read and write via negative index",
          "address": "0x1681-0x1684 (edit_cookie bounds check), 0x16a7-0x16de (edit_cookie OOB access), 0x17aa-0x17ad (read_cookie bounds check), 0x17bb-0x17e1 (read_cookie OOB access)",
          "expression": "msg[idx] and msg_size[idx] where idx is attacker-controlled with bit 63 set",
          "target": "msg[] array at 0x4060 (8-byte elements) and msg_size[] array at 0x4160 (4-byte elements), with negative idx accessing memory before these arrays in .bss",
          "size": "Depends on idx value; msg[idx] reads 8 bytes, msg_size[idx] reads 4 bytes, read() writes up to msg_size[idx]-1 bytes"
