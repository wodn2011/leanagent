index] via printf(%s), frees msg[random_index], then swaps msg[cookie_num-1] into msg[random_index] (swap-remove), decrements cookie_num. NOTE: freed pointer is NOT set to NULL before swap-overwrite\"},{\"name\":\"edit_cookie\",\"address\":\"0x1628\",\"callers\":[\"main\"],\"callees\":[\"printf\",\"__isoc99_scanf\",\"_abort\",\"read\",\"puts\",\"__stack_chk_fail\"],\"inputs\":[{\"name\":\"cookie_index\",\"source\":\"scanf %llu\",\"type\":\"unsigned long long\"},{\"name\":\"new_message\",\"source\":\"read(0, buf, msg_size[index]-1)\",\"type\":\"raw bytes\"}],\"checks\":[\"cookie_index < cookie_num else _abort (NO lower-bound check)\"],\"memory_operations\":[{\"operation\":\"READ\",\"source\":\"msg_size[cookie_index]\",\"size\":4,\"destination_type\":\"global_array_read\"},{\"operation\":\"WRITE\",\"destination\":\"msg[cookie_index] heap buffer\",\"size\":\"msg_size[cookie_index]-1\",\"destination_type\":\"heap_write via read()\"}],\"calls\":[\"printf\",\"__isoc99_scanf\",\"read\",\"puts\",\"_abort\"],\"summary\":\"Edits a cookie: reads index via scanf(%llu), checks index < cookie_num (no negative/lower-bound check), reads msg_size[index], calls read(0, msg[index], msg_size[index]-1). The read size is derived from msg_size array which is paired with msg pointers\"},{\"name\":\"read_cookie\",\"address\":\"0x1751\",\"callers\":[\"main\"],\"callees\":[\"printf\",\"__isoc99_scanf\",\"_abort\",\"__stack_chk_fail\"],\"inputs\":[{\"name\":\"cookie_index\",\"source\":\"scanf %llu\",\"type\":\"unsigned long long\"}],\"checks\":[\"cookie_index < cookie_num else _abort (NO lower-bound check)\"],\"memory_operations\":[{\"operation\":\"READ\",\"source\":\"msg[cookie_index]\",\"size\":8,\"destination_type\":\"global_array_read\"},{\"operation\":\"READ\",\"source\":\"msg[cookie_index] content\",\"size\":\"unknown\",\"destination_type\":\"heap_dereference via printf(%s)\"}],\"calls\":[\"printf\",\"__isoc99_scanf\",\"_abort\"],\"summary\":\"Views a cookie: reads index via scanf(%llu),