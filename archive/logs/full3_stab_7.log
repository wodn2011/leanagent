    "attack_surfaces": [
      {
        "function": "eat_cookie",
        "input": "random_index from /dev/urandom",
        "operation": "FREE msg[random_index] then swap-remove without NULLing pointer",
        "risk": "HIGH",
        "reason": "free() is called on msg[random_index], then msg[cookie_num-1] is swapped into that slot. The freed pointer is overwritten by the swap, but if the same index is selected again before swap (impossible since random), or if the swap brings a freed pointer scenario. Key concern: after free, the pointer is used in printf(%s) BEFORE free, but the swap-remove leaves no dangling pointer in the array. However, the freed chunk enters tcache/fastbin and can be reallocated by create_cookie."
      },
      {
        "function": "edit_cookie",
        "input": "cookie_index via scanf(%llu)",
        "operation": "READ/WRITE msg[cookie_index] with size msg_size[cookie_index]-1",
        "risk": "HIGH",
        "reason": "User-controlled index reaches heap pointer dereference. Index check is only upper-bound (index < cookie_num), no lower-bound check. Since index is unsigned (%llu), negative values wrap to large unsigned values but would fail the upper-bound check. However, if a freed chunk's pointer remains accessible (UAF scenario from eat_cookie swap-remove edge cases), edit could write to freed memory."
      },
      {
        "function": "read_cookie",
        "input": "cookie_index via scanf(%llu)",
        "operation": "READ msg[cookie_index] via printf(%s)",
        "risk": "HIGH",
        "reason": "User-controlled index reaches heap pointer dereference for output. printf(%s) dereferences msg[index] and prints until NUL. If msg[index] points to freed/reallocated memory, this could leak heap or libc addresses."
      },
      {
        "function": "create_cookie",
        "input": "message_length via scanf(%lld)",
        "operation": "ALLOC calloc(message_length,1) and READ into it",
        "risk": "MEDIUM",
        "reason": "User-controlled allocation size (up to 256) and user-controlled read content. Size is bounded (<=256). calloc zeroes memory. This is the allocation path that can reuse freed chunks from eat_cookie."
      },
      {
        "function": "eat_cookie",
        "input": "random_index",
        "operation": "printf(%s) on msg[random_index] before free",
        "risk": "MEDIUM",
        "reason": "The content of the cookie is printed before free. If the cookie content was previously overwritten with heap metadata (via UAF edit), this could leak heap addresses."
      }
    ],
