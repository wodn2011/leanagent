ion\":true},\"preconditions\":[{\"id\":\"PC-01\",\"description\":\"cookie_index must be negative to pass signed jl check\",\"necessity\":\"Required\",\"verified\":true},{\"id\":\"PC-02\",\"description\":\"msg[negative_index] must contain a valid FILE* pointer for successful read\",\"necessity\":\"Required - NULL causes crash, invalid pointer causes segfault\",\"verified\":true},{\"id\":\"PC-03\",\"description\":\"Multiple negative indices must map to different valid FILE* pointers\",\"necessity\":\"Required to demonstrate relative read across multiple targets\",\"verified\":true}],\"alias_key_findings\":[{\"expression\":\"msg[-4]=stderr FILE* (0x4040), msg[-6]=stdin FILE* (0x4030), msg[-8]=stdout FILE* (0x4020)\",\"alias\":\"Three BSS FILE* pointers alias to msg[-4], msg[-6], msg[-8]\",\"implication\":\"Three distinct read targets accessible via different negative indices, confirming RELATIVE_READ\"}],\"verification_plan\":{\"method\":\"Run read_cookie (menu option 4) with indices -4, -6, -8 in separate process instances, capture leaked bytes from each FILE structure\",\"environment\":\"Linux x86-64, glibc 2.39, PIE enabled\",\"run_command\":\"python3 /work/test/poc-BUG-001.py\",\"expected_evidence\":[\"Non-zero leaked bytes from stderr FILE struct (index -4)\",\"Non-zero leaked bytes from stdin FILE struct (index -6)\",\"Non-zero leaked bytes from stdout FILE struct (index -8)\",\"Different leak content from each structure\"]},\"mitigations\":[{\"name\":\"PIE\",\"present\":true,\"primitive_impact\":\"PIE does not prevent relative read. BSS layout preserved, FILE* pointers still accessible via negative indices.\"},{\"name\":\"Full RELRO\",\"present\":true,\"primitive_impact\":\"Not relevant to read primitive.\"},{\"name\":\"NX\",\"present\":true,\"primitive_impact\":\"Not relevant to read primitive.\"},{\"name\":\"Canary\",\"present\":true,\"primitive_impact\":\"Not relevant to read primitive.\"}],\"evidence\":[{\"id\":\"E014\",\"type\":\"DYNAMIC\",\"function\":\"re