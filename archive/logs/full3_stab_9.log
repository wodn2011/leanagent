  "ctx_json": "{\"binary_info\":null,\"recon_report\":{\"schema\":\"ReconReport\",\"version\":\"1.0\",\"stage\":\"S1\",\"status\":\"COMPLETED\",\"binary\":{\"path\":\"/work/test/target\",\"arch\":\"amd64\",\"bits\":64,\"endianness\":\"little\",\"entry\":\"0x1110\",\"dynamic\":true,\"stripped\":false,\"file_type\":\"ELF 64-bit LSB pie executable, x86-64, dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2\",\"compiler\":\"GCC (Debian 10.2.0-16) 10.2.0\",\"source_file\":\"fortunecookie.c\",\"buildid\":\"84dab319bf6fe22134cf0338cbd8071fd8bc06c2\"},\"security\":{\"relro\":{\"value\":\"full\",\"source\":\"ELF\"},\"nx\":{\"value\":true,\"source\":\"ELF\"},\"canary\":{\"value\":true,\"source\":\"ELF\"},\"pie\":{\"value\":true,\"source\":\"ELF\"},\"fortify\":{\"value\":false,\"source\":\"ELF\"},\"cet\":{\"ibt\":{\"value\":\"unknown\",\"source\":\"ELF\"},\"shstk\":{\"value\":\"unknown\",\"source\":\"ELF\"}},\"aslr\":{\"value\":\"unknown\",\"source\":\"UNKNOWN\"}},\"runtime\":{\"libc\":{\"version\":\"2.39\",\"path\":\"/lib/x86_64-linux-gnu/libc.so.6\",\"source\":\"RUNTIME\",\"distro\":\"Ubuntu GLIBC 2.39-0ubuntu8.8\"},\"loader\":{\"path\":\"/lib64/ld-linux-x86-64.so.2\",\"source\":\"ELF\"},\"libraries\":[\"libc.so.6\",\"ld-linux-x86-64.so.2\"]},\"interface\":{\"entry_function\":\"main\",\"input_sources\":[\"stdin\"],\"menu\":[\"==Fortune Cookie==\",\"1. Eat one cookie!!\",\"2. Make new cookie.\",\"3. Edit cookie msg.\",\"4. View cookie msg.\",\"5. exit\",\"==================\"],\"user_controlled_inputs\":[{\"name\":\"menu_choice\",\"source\":\"scanf(%lld)\",\"function\":\"main\",\"description\":\"main menu selection 1-5\"},{\"name\":\"msg_length\",\"source\":\"scanf(%lld)\",\"function\":\"create_cookie\",\"description\":\"message length for new cookie, checked <= 0x100\"},{\"name\":\"cookie_index_edit\",\"source\":\"scanf(%llu)\",\"function\":\"edit_cookie\",\"description\":\"index of cookie to edit, checked idx < cookie_num (signed jl)\"},{\"name\":\"cookie_index_rea