  "ctx_json": "{\"binary_info\":null,\"recon_report\":{\"schema\":\"ReconReport\",\"version\":\"1.0\",\"stage\":\"S1\",\"status\":\"COMPLETED\",\"binary\":{\"path\":\"/work/test/target\",\"arch\":\"amd64\",\"bits\":64,\"endianness\":\"little\",\"entry\":\"0x1110\",\"dynamic\":true,\"stripped\":false,\"compiler\":\"GCC 10.2.0 (Debian 10.2.0-16)\",\"source_file\":\"fortunecookie.c\",\"interpreter\":\"/lib64/ld-linux-x86-64.so.2\"},\"security\":{\"relro\":{\"value\":\"full\",\"source\":\"ELF\"},\"nx\":{\"value\":true,\"source\":\"ELF\"},\"canary\":{\"value\":true,\"source\":\"ELF\"},\"pie\":{\"value\":true,\"source\":\"ELF\"},\"fortify\":{\"value\":\"false\",\"source\":\"ELF\"},\"cet\":{\"ibt\":{\"value\":\"unknown\",\"source\":\"UNKNOWN\"},\"shstk\":{\"value\":\"unknown\",\"source\":\"UNKNOWN\"}},\"aslr\":{\"value\":\"true\",\"source\":\"RUNTIME\"}},\"runtime\":{\"libc\":{\"version\":\"2.39\",\"path\":\"/lib/x86_64-linux-gnu/libc.so.6\",\"distro\":\"Ubuntu GLIBC 2.39-0ubuntu8.8\",\"source\":\"RUNTIME\"},\"loader\":{\"path\":\"/lib64/ld-linux-x86-64.so.2\",\"source\":\"ELF\"},\"libraries\":[\"libc.so.6\"]},\"interface\":{\"entry_function\":\"main\",\"input_sources\":[\"stdin\"],\"menu\":[{\"choice\":\"1\",\"label\":\"Eat one cookie!!\",\"function\":\"eat_cookie\"},{\"choice\":\"2\",\"label\":\"Make new cookie.\",\"function\":\"create_cookie\"},{\"choice\":\"3\",\"label\":\"Edit cookie msg.\",\"function\":\"edit_cookie\"},{\"choice\":\"4\",\"label\":\"View cookie msg.\",\"function\":\"read_cookie\"},{\"choice\":\"5\",\"label\":\"exit\",\"function\":\"exit\"}],\"user_controlled_inputs\":[{\"name\":\"menu_choice\",\"source\":\"scanf(%lld, &var)\",\"function\":\"main\",\"type\":\"int64\"},{\"name\":\"message_size\",\"source\":\"scanf(%lld, &var)\",\"function\":\"create_cookie\",\"type\":\"int64\",\"constraint\":\"<=0x100\"},{\"name\":\"message_data\",\"source\":\"read(0, buf, size)\",\"function\":\"create_cookie\",\"type\":\"raw_bytes\"},{\"name\":\"cookie_index\",\"source\":\"scanf(%llu, &var)\",\"function\":\"edit_cookie\",\"type\":\"uint64\"},{\"name\":\"edit_data\",\"source\":\"read(0, msg[idx], msg_size[idx]-1)\",\"function\":\"edit_cookie\",\"type\":\"raw_bytes\"},{\"name\":\"cookie_index\",\"source\":\"scanf(%llu, &var)\",\"function\":\"read_cookie\",\"type\":\"uint64\"}]},\"memory\":{\"sections\":[{\"name\":\".text\",\"address\":\"0x1110\",\"size\":\"0x891\",\"flags\":\"AX\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".rodata\",\"address\":\"0x2000\",\"size\":\"0x266\",\"flags\":\"A\",\"writable\":false,\"executable\":false,\"readable\":true},{\"name\":\".data\",\"address\":\"0x4000\",\"size\":\"0x10\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".bss\",\"address\":\"0x4020\",\"size\":\"0x1d0\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".got\",\"address\":\"0x3f58\",\"size\":\"0xa8\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".plt\",\"address\":\"0x1020\",\"size\":\"0xe0\",\"flags\":\"AX\",\"writable\":false,\"executable\":true,\"readable\":true},{\"name\":\".init_array\",\"address\":\"0x3d58\",\"size\":\"0x8\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".fini_array\",\"address\":\"0x3d60\",\"size\":\"0x8\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".dynamic\",\"address\":\"0x3d68\",\"size\":\"0x1f0\",\"flags\":\"WA\",\"writable\":true,\"executable\":false,\"readable\":true},{\"name\":\".eh_frame\",\"address\":\"0x22e0\",\"size\":\"0x1e0\",\"flags\":\"A\",\"writable\":false,\"executable\":false,\"readable\":true},{\"name\":\".eh_frame_hdr\",\"address\":\"0x2268\",\"size\":\"0x74\",\"flags\":\"A\",\"writable\":false,\"executable\":false,\"readable\":true}],\"globals\":[{\"name\":\"stdout\",\"address\":\"0x4020\",\"size\":8,\"type\":\"FILE*\",\"section\":\".bss\"},{\"name\":\"stdin\",\"add