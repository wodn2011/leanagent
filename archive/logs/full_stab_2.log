    "attack_surfaces": [
      {
        "function": "edit_cookie",
        "input": "cookie_index (scanf %llu, unsigned long long)",
        "operation": "WRITE to msg[idx] dereferenced heap buffer, size from msg_size[idx]-1",
        "risk": "HIGH",
        "reason": "Index read as unsigned long long with only upper-bound check (idx < cookie_num). No lower bound check. Negative values (large unsigned) pass the check and index into msg[] before 0x4060, potentially hitting urandom(0x41e0), cookie_num(0x41e8), or other BSS globals. msg_size[idx] for negative idx reads from before 0x4160. The read destination msg[idx] for negative idx loads an arbitrary 8-byte value as a heap pointer, and read() writes to that address."
      },
      {
        "function": "read_cookie",
        "input": "cookie_index (scanf %llu, unsigned long long)",
        "operation": "READ msg[idx] dereferenced as string, printed via printf",
        "risk": "HIGH",
        "reason": "Same missing lower bound check as edit_cookie. Negative index loads msg[idx] as a pointer and printf prints the string at that address. Potential arbitrary read if attacker controls the pointer value at negative offset."
      },
      {
        "function": "eat_cookie",
        "input": "random index from /dev/urandom",
        "operation": "FREE msg[random_idx], then swap msg[cookie_num-1] into msg[random_idx]",
        "risk": "MEDIUM",
        "reason": "After free(msg[random_idx]), the freed pointer is overwritten with msg[cookie_num-1]. However, if random_idx == cookie_num-1 (last element freed), the swap writes the freed pointer back into itself (msg[last] = msg[last]), leaving a dangling pointer in the array. This pointer can be reused via edit_cookie or read_cookie. The swap does not NULL out the source slot."
      },
      {
        "function": "create_cookie",
        "input": "message_length (scanf %lld, signed long long)",
        "operation": "calloc(message_length, 1) then read(0, buf, message_length)",
        "risk": "MEDIUM",
        "reason": "Size checked with cmp rax,0x100; jle (signed <= 256). Negative values pass the check. calloc with negative size (interpreted as huge unsigned by calloc internally) may fail or return small allocation. read() then uses the original signed value as count, which on x86-64 syscall uses the 64-bit value directly."
      }
    ],
