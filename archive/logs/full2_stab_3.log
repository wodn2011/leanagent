      },
      {
        "id": "F011",
        "type": "FACT",
        "description": "read_cookie reads index via scanf(\"%llu\") into uint64 at rbp-0x10, checks index < cookie_num using jl (signed less-than)",
        "source": "DISASSEMBLY"
      },
      {
        "id": "F012",
        "type": "FACT",
        "description": "edit_cookie reads msg_size[index]-1 bytes into msg[index] via read(0, msg[index], msg_size[index]-1)",
