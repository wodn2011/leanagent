        ],
        "attack_surface": {
          "input": "view_index via scanf(\"%llu\") in read_cookie",
          "entry_function": "read_cookie",
          "data_flow": [
            "Attacker provides menu choice 4 → read_cookie called",
            "scanf(\"%llu\", &idx) at 0x179a reads unsigned 64-bit index into [rbp-0x10]",
            "At 0x17a3: mov rax,[rip+cookie_num] loads cookie_num into rax",
