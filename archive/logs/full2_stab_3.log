        "type": "FACT",
        "description": "init() pre-creates 5 cookies via strdup with sizes 0x50,0x30,0x18,0x38,0x40 and sets cookie_num=5",
        "source": "DISASSEMBLY"
      },
      {
        "id": "F008",
        "type": "FACT",
        "description": "create_cookie checks cookie_num<=0x1f (jle) and message_size<=0x100 (jle), uses calloc(size,1) and read(0,buf,size)",
        "source": "DISASSEMBLY"
      },
      {
        "id": "F009",
        "type": "FACT",
        "description": "eat_cookie reads 1 byte from /dev/urandom, computes random_index = byte % cookie_num, frees msg[random_index], then swaps msg[cookie_num-1] into msg[random_index] and decrements cookie_num",
