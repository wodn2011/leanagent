    "attack_surfaces": [
      {
        "function": "edit_cookie",
        "input": "edit_index (scanf %llu, unsigned)",
        "operation": "msg[edit_index] dereference + read(0, msg[edit_index], msg_size[edit_index]-1)",
        "risk": "HIGH",
        "reason": "edit_index read as unsigned uint64 via %llu but bounds check uses jl (signed less-than). Input like 0xFFFFFFFFFFFFFFFF passes check (interpreted as -1 < cookie_num) then msg[0xFFFFFFFFFFFFFFFF] causes OOB read of pointer from msg array, which is then used as write destination by read(). Attacker-controlled index reaches pointer dereference and arbitrary-size write."
      },
      {
        "function": "read_cookie",
        "input": "view_index (scanf %llu, unsigned)",
        "operation": "printf(\"%s\", msg[view_index])",
        "risk": "HIGH",
        "reason": "view_index read as unsigned uint64 via %llu but bounds check uses jl (signed less-than). Same signed/unsigned mismatch as edit_cookie. OOB read from msg array yields a pointer that is passed to printf as string, potentially leaking memory content."
      },
      {
        "function": "eat_cookie",
        "input": "random_index (fread from /dev/urandom)",
        "operation": "free(msg[random_index]) then swap msg[cookie_num-1] -> msg[random_index] without clearing",
        "risk": "MEDIUM",
        "reason": "After free, the freed pointer is overwritten by swap (msg[random_index] = msg[cookie_num-1]), but the old msg[cookie_num-1] slot is not zeroed. If cookie_num-1 == random_index (only one cookie), the freed pointer remains in msg[random_index]. Index is random (not attacker-controlled), limiting direct exploitation, but the swap logic may leave dangling pointers in edge cases."
      },
      {
        "function": "create_cookie",
        "input": "message_size (scanf %lld)",
        "operation": "calloc(message_size, 1) then read(0, buf, message_size)",
        "risk": "LOW",
        "reason": "message_size checked <= 0x100 and cookie_num <= 0x1f. calloc zero-initializes. No obvious overflow. Size is user-controlled but bounded."
      },
      {
        "function": "edit_cookie",
        "input": "msg_size[edit_index] (from create_cookie, user-controlled size)",
        "operation": "read(0, msg[edit_index], msg_size[edit_index]-1)",
        "risk": "MEDIUM",
        "reason": "The read length is derived from msg_size which was set during create_cookie from user input (up to 0x100). If OOB index is used to read msg_size from an adjacent global variable, the read length could be controlled, amplifying the OOB write primitive."
      }
    ],
