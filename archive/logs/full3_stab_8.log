    "attack_surfaces": [
      {
        "function": "eat_cookie",
        "input": "random_byte from /dev/urandom",
        "operation": "FREE + swap-remove without NULL",
        "risk": "HIGH",
        "reason": "free(msg[idx]) is called but msg[idx] is not set to NULL before the swap-remove step. When idx == cookie_num-1 (last element), the swap becomes self-assignment: msg[idx] = msg[cookie_num-1] writes the freed pointer back into itself. The freed pointer remains accessible in the msg array. This is a FACT observable in disassembly at 0x158e-0x15c6."
      },
      {
        "function": "eat_cookie",
        "input": "random index selection",
        "operation": "free then printf before free",
        "risk": "MEDIUM",
        "reason": "printf(\"%s\", msg[idx]) is called BEFORE free(msg[idx]) at 0x156e-0x158e. The message is printed then freed. If the pointer were stale from a prior free, this would be a use-after-free read. The swap-remove logic may leave a freed pointer accessible under specific conditions."
      },
      {
        "function": "edit_cookie",
        "input": "user-controlled index (scanf %llu)",
        "operation": "WRITE to msg[index] heap buffer",
        "risk": "HIGH",
        "reason": "Attacker controls index (uint64). Check is index < cookie_num (signed jl at 0x1684). If a freed pointer remains in msg[] due to eat_cookie not nulling, edit_cookie could write to a freed chunk. read(0, msg[index], msg_size[index]-1) dereferences msg[index] as write destination."
      },
      {
        "function": "read_cookie",
        "input": "user-controlled index (scanf %llu)",
        "operation": "READ via printf %s of msg[index]",
        "risk": "HIGH",
        "reason": "Attacker controls index (uint64). Check is index < cookie_num (signed jl at 0x17aa). printf(\"%s\", msg[index]) dereferences msg[index] as a string pointer. If a freed/corrupted pointer is in msg[], this is a read through attacker-influenced pointer."
      },
      {
        "function": "edit_cookie",
        "input": "user-controlled index",
        "operation": "signed comparison for unsigned input",
        "risk": "MEDIUM",
        "reason": "scanf %llu reads uint64, but comparison at 0x1681 uses 'jl' (signed less-than). The index is loaded as 64-bit and compared with cookie_num using signed jl. Large unsigned values (≥0x8000000000000000) would be negative in signed interpretation, potentially passing the check. However, the subsequent array indexing uses [rax*8] which would produce a huge offset, likely causing a crash rather than controlled OOB."
      },
      {
        "function": "read_cookie",
        "input": "user-controlled index",
        "operation": "signed comparison for unsigned input",
        "risk": "MEDIUM",
        "reason": "Same signed/unsigned mismatch as edit_cookie: scanf %llu + jl comparison at 0x17aa."
      },
      {
        "function": "create_cookie",
        "input": "user-controlled size (scanf %lld)",
        "operation": "calloc + read with user size",
        "risk": "LOW",
        "reason": "Size is checked ≤ 0x100 and calloc(1,size) allocates exactly that much. read(0,buf,size) reads exactly size bytes. No overflow in create itself, but the size stored in msg_size[] controls edit_cookie's read length later."
      }
    ],
